[Unit]
Description=CDP Gate - Credential Delegation Protocol daemon
Documentation=https://github.com/user/cdp
After=network.target

[Service]
Type=notify
ExecStart=/usr/bin/cdp-gate
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
LockPersonality=true

# Allow socket and config access
ReadWritePaths=/run/cdp
ReadOnlyPaths=%h/.config/cdp

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=default.target
